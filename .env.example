# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop / Claude Code / Zed)
# "streamable-http" — remote HTTP server (containers, cloud deploys)
#
# On a cloud host (Databricks Apps) you usually leave this as
# stdio: app.py automatically switches to HTTP when the platform injects a port
# (DATABRICKS_APP_PORT or PORT).
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when running over HTTP) ───────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── Databricks SQL backend ───────────────────────────────────────────────────
# Local dev auth: either `databricks auth login` and DATABRICKS_CONFIG_PROFILE,
# or DATABRICKS_HOST + DATABRICKS_TOKEN. On Databricks Apps these are injected.
DATABRICKS_HOST=
DATABRICKS_CONFIG_PROFILE=DEFAULT
DATABRICKS_SQL_WAREHOUSE_ID=
DATABRICKS_CATALOG=users
DATABRICKS_SCHEMA=
SQL_TIMEOUT_SECONDS=30
